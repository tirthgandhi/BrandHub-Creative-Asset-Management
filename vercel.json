{
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "functions": { "api/index.mjs": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/((?!demo-media/|assets/|.*\\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }
  ]
}
