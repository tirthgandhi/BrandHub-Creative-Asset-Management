# Set these in Vercel Project Settings -> Environment Variables.
# Use repository root as Root Directory. Enable Production and Preview as needed.
NODE_ENV=production
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/brandhub_demo?retryWrites=true&w=majority
SESSION_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CLIENT_URL=https://YOUR-PROJECT.vercel.app
ASSET_STORAGE=gridfs
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_NAME=brandhub_session
# Optional: frontend build setting. This is a public path, NOT a service binding.
VITE_API_URL=/api
# Keep uploads under the Vercel function request limit, including multipart data.
MEDIA_IMAGE_MAX_BYTES=4000000
MEDIA_VIDEO_MAX_BYTES=4000000
MEDIA_DOCUMENT_MAX_BYTES=4000000
GRIDFS_UPLOAD_BUDGET_BYTES=262144000
# Do not set SERVER_URL/BACKEND_URL: no runtime service bindings are needed here.
# Do not set PORT or VITE_API_PROXY_TARGET on Vercel.
