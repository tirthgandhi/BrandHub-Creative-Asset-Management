# Shared runtime
NODE_ENV=development

# Server
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/brandhub
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_NAME=brandhub_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Cloudinary (server only; never prefix secrets with VITE_)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ASSET_FOLDER=brandhub/development
CLOUDINARY_SIGNED_URL_TTL_SECONDS=300

# Client (compiled into the browser bundle)
VITE_API_URL=/api

# Development-only seed safety gates (Phase 6)
ALLOW_SEED=false
SEED_ADMIN_EMAIL=admin@brandhub.demo
SEED_ADMIN_PASSWORD=replace-before-running-seed

# Phase 2 initial administrator (server only)
ADMIN_EMAIL=admin@brandhub.demo
ADMIN_PASSWORD=replace-with-a-strong-development-password
ADMIN_NAME=BrandHub Admin
