# Environment reference for BrandHub.
# Server: copy server/.env.example to server/.env, then configure private values there.
# Client: copy ONLY the two VITE_ entries below into client/.env.local if overriding defaults.
# A root .env is not automatically loaded by the server workspace or client Vite root.
# Never place database/session/Cloudinary secrets in VITE_ variables.

# Same-origin requests work without a client environment file.
VITE_API_URL=/api
# Optional development proxy override (default shown).
VITE_API_PROXY_TARGET=http://127.0.0.1:5000

# Copy to server/.env. This file contains examples only; never commit real secrets.
# npm workspace server commands load server/.env through dotenv.
NODE_ENV=development
PORT=5000
# Match the browser origin exactly, including localhost versus 127.0.0.1.
CLIENT_URL=http://127.0.0.1:5173
MONGODB_URI=mongodb://127.0.0.1:27017/brandhub_dev
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_NAME=brandhub_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Default upload backend: MongoDB GridFS. Cloudinary is optional for legacy assets.
ASSET_STORAGE=gridfs
MEDIA_IMAGE_MAX_BYTES=5242880
MEDIA_VIDEO_MAX_BYTES=20971520
GRIDFS_UPLOAD_BUDGET_BYTES=262144000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ASSET_FOLDER=brandhub/development
CLOUDINARY_SIGNED_URL_TTL_SECONDS=300

# Initial Project Manager: npm run seed:admin (repository root).
# Replace the password before running; these are not application login credentials.
ADMIN_EMAIL=admin@brandhub.example
ADMIN_PASSWORD=replace-with-a-strong-development-password
ADMIN_NAME=BrandHub Project Manager

# Optional catalog seed: requires a non-production Atlas database named brandhub_demo.
# seed:brandhub uses ADMIN_PASSWORD and DEMO_USER_PASSWORD, not the preview password.
DEMO_USER_PASSWORD=replace-with-a-strong-development-password
# Historical import/seed scripts may require these additional gates.
ALLOW_SEED=false
SEED_ADMIN_EMAIL=admin@brandhub.example
SEED_ADMIN_PASSWORD=replace-with-a-strong-development-password
